{
  "name": "open-pipe-club-app",
  "private": true,
  "version": "1.6.6",
  "description": "Open Pipe Club App",
  "author": "Open Pipe Club",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "set NODE_OPTIONS=--no-deprecation && vite",
    "build": "set NODE_OPTIONS=--no-deprecation && vite build",
    "preview": "set NODE_OPTIONS=--no-deprecation && vite preview",
    "dist": "set NODE_OPTIONS=--no-deprecation && vite build && electron-builder"
  },
  "build": {
    "appId": "com.openpipeclubgroup.tracker",
    "productName": "Open Pipe Club App",
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/discord-rpc/**"
    ],
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist",
      "dist-electron",
      "public/logo.png",
      "package.json",
      "!**/*.md",
      "!**/*.map",
      "!**/tsconfig*.json"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName} Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.ico",
      "executableName": "Open Pipe Club App"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/material": "^9.0.1",
    "@turf/bbox": "^7.3.5",
    "@turf/bearing": "^7.3.5",
    "@turf/clean-coords": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "@types/proj4": "^2.5.6",
    "discord-rpc": "^4.0.1",
    "mobx": "^6.15.4",
    "mobx-react-lite": "^4.1.1",
    "proj4": "^2.20.8",
    "react-map-gl": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/discord-rpc": "^4.0.10",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.0",
    "date-fns": "^4.1.0",
    "electron": "^41.7.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.5.0",
    "lucide-react": "^0.507.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "postcss": "^8.5.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.1",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
