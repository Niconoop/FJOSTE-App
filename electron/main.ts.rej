+function checkDiscordPermissionError(): Promise<boolean> {
+  return new Promise((resolve) => {
+    if (process.platform !== 'win32') {
+      resolve(false);
+      return;
+    }
+    const socket = net.createConnection('\\\\.\\pipe\\discord-ipc-0');
+    socket.on('connect', () => {
+      socket.destroy();
+      resolve(false);
+    });
+    socket.on('error', (err: any) => {
+      socket.destroy();
+      if (err.code === 'EPERM') {
+        resolve(true);
+      } else {
+        resolve(false);
+      }
+    });
+  });
+}
